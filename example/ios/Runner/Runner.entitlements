<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  NFC Tag Reading is intentionally omitted so the example builds on a
	  personal/free Apple ID team.

	  Paid Apple Developer Program only — add:
	    <key>com.apple.developer.nfc.readersession.formats</key>
	    <array><string>TAG</string></array>
	  Then enable "Near Field Communication Tag Reading" on the App ID.
	  See ../../doc/IOS_NFC_SETUP.md
	-->
</dict>
</plist>
